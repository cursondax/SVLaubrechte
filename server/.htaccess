# Schuetzt das data/-Verzeichnis vor direktem Browser-Zugriff.
# Nur api.php darf rein.
<FilesMatch "\.(json|tmp)$">
    Require all denied
</FilesMatch>

# Falls aeltere Apache-Version (2.2):
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(json|tmp)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# config.php auch sperren (PHP-Auslieferung als Text verhindern faengt Fehlkonfig ab)
<Files "config.php">
    Require all denied
</Files>
<IfModule !mod_authz_core.c>
    <Files "config.php">
        Order allow,deny
        Deny from all
    </Files>
</IfModule>

# Directory-Listing verbieten
Options -Indexes
